{
  "name": "comnyang",
  "version": "1.0.0",
  "description": "A pixel cat that lives on your desktop",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run build:watch\" \"npm run electron:dev\"",
    "build": "tsc --project tsconfig.main.json && tsc --project tsconfig.renderer.json && npm run copy-html",
    "copy-html": "node scripts/copy-html.js",
    "build:watch": "concurrently \"tsc --project tsconfig.main.json -w\" \"tsc --project tsconfig.renderer.json -w\" \"node scripts/watch-html.js\"",
    "electron:dev": "wait-on dist/main/index.js && cross-env NODE_ENV=development electron .",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder build --publish never",
    "package:mac": "npm run build && electron-builder build --mac --publish never",
    "package:win": "npm run build && electron-builder build --win --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uiohook-napi": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.comnyang.app",
    "productName": "Comnyang",
    "copyright": "Copyright © 2024 Comnyang",
    "files": ["dist/**/*", "assets/**/*"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
