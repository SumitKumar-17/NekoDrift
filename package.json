{
  "name": "nekodrift",
  "version": "1.0.0",
  "description": "A pixel cat that drifts on your desktop",
  "author": {
    "name": "SumitKumar-17",
    "email": "sumitkanpur2005@gmail.com"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build-main.js && node scripts/build-renderer.js",
    "start": "npm run build && electron --no-sandbox .",
    "dev": "npm run build && electron --no-sandbox .",
    "package": "npm run build && electron-builder build --publish never",
    "package:mac": "npm run build && electron-builder build --mac --publish never",
    "package:win": "npm run build && electron-builder build --win --publish never",
    "package:linux": "npm run build && electron-builder build --linux --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uiohook-napi": "^1.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nekodrift.app",
    "productName": "NekoDrift",
    "copyright": "Copyright © 2024 NekoDrift",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/conf/**/*",
      "node_modules/dot-prop/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/atomically/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "SumitKumar-17",
      "repo": "NekoDrift"
    }
  }
}
